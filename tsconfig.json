{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "allowJs": true,
    "target": "ESNext",
    "module": "ESNext",
    "downlevelIteration": true,
    "typeRoots": ["node_modules/@types"],
    "lib": ["es2017", "dom"]
  }
}
